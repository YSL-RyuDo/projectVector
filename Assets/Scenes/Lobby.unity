--- !u!114 &30328570
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 30328568}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe64dbafdc5a2ae4bb5c654900c75451, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CharacterSelectManager
  characters:
  - characterId: 0
    characterName: "\uC774\uB2C8\uC2DC\uC5D0\uC774\uD130"
    characterPrefab: {fileID: 7654540031228714352, guid: 9e0bb408906eb7349b28e9c6d11586f1, type: 3}
    characterSprite: {fileID: 21300000, guid: dc9bf2d90dd707d40a8b7a6b5f9f3eb9, type: 3}
    isOwned: 1
    lockImage: {fileID: 1796420977}
    selectButton: {fileID: 43918093}
    outline: {fileID: 43918092}
    qSkillName: "\uD14C\uC774\uC800 \uB4DC\uB860"
    qSkillDesc: "\uD50C\uB808\uC774\uC5B4\uAC00 Q\uB97C \uC785\uB825\uD558\uBA74
      \uC9E7\uC740 \uC2DC\uC804 \uD6C4 \uB4DC\uB860\uC774 \uC0DD\uC131\uB418\uACE0
      \uCE74\uBA54\uB77C\uAC00 \uB4DC\uB860 \uC2DC\uC810\uC73C\uB85C \uC804\uD658\uB41C\uB2E4.
      \uD50C\uB808\uC774\uC5B4 \uBCF8\uCCB4\uB294\r\n\uC81C\uC790\uB9AC \uACE0\uC815
      \uC0C1\uD0DC\uAC00 \uB418\uBA70, \uB4DC\uB860\uC744 \uC9C1\uC811 \uC870\uC791\uD574
      \uC88C\uD074\uB9AD 1\uD68C\uB85C \uD14C\uC774\uC800\uB97C \uBC1C\uC0AC\uD560
      \uC218 \uC788\uB2E4. \uC801\uC911 \uC2DC \uD53C\uD574\uC640 \uAC10\uC804\r\n1\uC2A4\uD0DD\uC744
      \uBD80\uC5EC\uD558\uACE0, \uBC1C\uC0AC \uC989\uC2DC \uB4DC\uB860\uC744 \uC885\uB8CC\uD55C\uB2E4.
      \uC885\uB8CC \uD6C4 \uCE74\uBA54\uB77C\uB97C \uBCF5\uADC0\uC2DC\uD0A4\uACE0
      \uCFE8\uD0C0\uC784\uC744 \uC2DC\uC791\uD55C\uB2E4."
    wSkillName: "\uC2A4\uCE90\uB108"
    wSkillDesc: "\uD50C\uB808\uC774\uC5B4\uAC00 C\uB97C \uC785\uB825\uD558\uBA74
      \uD22C\uCC99 \uC560\uB2C8\uBA54\uC774\uC158 \uD6C4 \uC2A4\uCE90\uB108 \uC7A5\uCE58\uB97C
      \uC804\uBC29\uC73C\uB85C \uD22C\uCC99\uD55C\uB2E4. \uC7A5\uCE58\uAC00 \uBC14\uB2E5
      \uB610\uB294 \uBCBD\uBA74\r\n\uADFC\uCC98\uC5D0 \uC548\uCC29\uD558\uBA74 \uC9E7\uC740
      \uD65C\uC131\uD654 \uC2DC\uAC04 \uD6C4 \uD0D0\uC9C0\uB97C \uC2DC\uC791\uD558\uBA70,
      \uBC94\uC704 \uC548\uC5D0\uC11C \uC6C0\uC9C1\uC774\uB294 \uC801\uC744 \uBC1C\uACAC\uD558\uBA74
      \uC804\uAE30 1\uD68C\uB97C\r\n\uBC1C\uC0AC\uD574 \uD53C\uD574\uC640 \uAC10\uC804
      1\uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD55C\uB2E4. \uC9C0\uC18D\uC2DC\uAC04 \uC885\uB8CC
      \uD6C4 \uC7A5\uCE58\uB97C \uC81C\uAC70\uD55C\uB2E4."
    eSkillName: "\uC804\uAE30\uC790\uC11D\uD30C"
    eSkillDesc: "\uD50C\uB808\uC774\uC5B4\uAC00 E\uB97C \uC785\uB825\uD558\uBA74
      \uC9E7\uC740 \uC120\uB51C \uD6C4 \uC804\uAE30 \uD30C\uB3D9\uC744 \uBC29\uCD9C\uD55C\uB2E4.
      \uBC18\uACBD \uB0B4 \uC801\uC744 \uD0D0\uC0C9\uD574 \uD604\uC7AC \uAC10\uC804
      \uC2A4\uD0DD \uC218\uB97C\r\n\uD655\uC778\uD558\uACE0, \uC2A4\uD0DD \uC218\uC5D0
      \uB530\uB77C \uAE30\uC808\uC744 \uC801\uC6A9\uD55C \uB4A4 \uAC10\uC804 \uC2A4\uD0DD\uC744
      \uC804\uBD80 \uC81C\uAC70\uD55C\uB2E4."
    rSkillName: "\uBC29\uC804 (\uAD81\uADF9\uAE30)"
    rSkillDesc: "\uD50C\uB808\uC774\uC5B4\uAC00 X\uB97C \uC785\uB825\uD558\uBA74
      \uC2DC\uC804 \uC560\uB2C8\uBA54\uC774\uC158\uC744 \uC2DC\uC791\uD558\uACE0
      \uC804\uBC29 \uBC94\uC704 \uC608\uACE0\uB97C \uD45C\uC2DC\uD55C\uB2E4. \uC9E7\uC740
      \uACBD\uACE0 \uC2DC\uAC04 \uD6C4 \uB099\uB8B0\r\n\uB2E4\uBC1C\uC744 \uC0DD\uC131\uD558\uBA70,
      \uAC01 \uB099\uB8B0 \uC9C0\uC810\uC5D0\uC11C \uBC18\uACBD \uD310\uC815\uC744
      \uC218\uD589\uD574 \uC801\uC911 \uB300\uC0C1\uC5D0\uAC8C \uD53C\uD574\uC640
      \uAC10\uC804 2\uC2A4\uD0DD\uC744 \uBD80\uC5EC\uD55C\uB2E4."
  - characterId: 1
    characterName: "\uCEE8\uD2B8\uB864\uB7EC"
    characterPrefab: {fileID: 4041467186585408180, guid: d0a6c656bc4b0d3459b08c6e2095a268, type: 3}
    characterSprite: {fileID: 21300000, guid: 081b60c7a99a3d9408f5b3a91dcc32c5, type: 3}
    isOwned: 1
    lockImage: {fileID: 877561748}
    selectButton: {fileID: 1740034549}
    outline: {fileID: 1740034546}
    qSkillName: "\uC5F0\uB9C9"
    qSkillDesc: "\uC911\uC559\uC5D0 \uBBF8\uB2C8 \uB9F5\uC744 \uB744\uC6B0\uACE0
      \uC88C\uD074\uB9AD\uD558\uC5EC \uC704\uCE58\uB97C \uC815\uD558\uACE0 \uC6B0\uD074\uB9AD\uC73C\uB85C
      \uD574\uB2F9 \uC704\uCE58\uC5D0 \uC5F0\uB9C9 \uD22C\uD558."
    wSkillName: "\uB2AA \uD568\uC815"
    wSkillDesc: "\uD568\uC815\uC744 \uD22C\uCC99\uD558\uC5EC \uBCBD\uC5D0 \uB2FF\uC73C\uBA74
      \uD295\uAE30\uACE0 \uBC14\uB2E5\uC5D0 \uB2FF\uC73C\uBA74 \uADF8 \uC790\uB9AC\uC5D0
      \uC804\uAC1C. \uC0C1\uB300\uB294 \uB2AA\uC5D0\uC11C \uC2AC\uB85C\uC6B0 \uD6A8\uACFC."
    eSkillName: "\uAD50\uB780 \uD568\uC815"
    eSkillDesc: "\uD568\uC815\uC744 \uD22C\uCC99\uD558\uC5EC \uC124\uCE58 (\uBCBD\uC5D0\uB3C4
      \uAC00\uB2A5). \uC124\uCE58 \uD6C4 \uC0AC\uC6A9 \uD0A4\uB97C \uB20C\uB7EC \uAE30\uBCF8
      \uD53C\uC2A4\uD1A8 \uC0AC\uACA9 \uC18C\uB9AC \uBC1C\uC0B0."
    rSkillName: "\uBABD\uD658\uC758 \uC232 (\uAD81\uADF9\uAE30)"
    rSkillDesc: "\uC2A4\uD0AC \uC2DC\uC804 \uC2DC \uC790\uC2E0\uC758 \uC8FC\uBCC0\uC73C\uB85C
      \uC548\uAC1C\uB97C \uBFCC\uB824 \uC601\uC5ED\uC744 \uC804\uAC1C. \uC548\uAC1C\uB294
      \uACF5\uD1B5\uC801\uC73C\uB85C \uC2DC\uC57C \uBC29\uD574 (\uBC1C\uB85C\uB780\uD2B8
      \uBC14\uC774\uD37C \uAD81). \uC0C1\uB300\uAC00 \uC601\uC5ED \uC9C4\uC785 \uC2DC
      \uC0C1\uB300\uB07C\uB9AC\uC758 \uC2DD\uBCC4 \uB80C\uB354\uB9C1 \uCC28\uB2E8.
      \uC0AC\uC6B4\uB4DC \uC6B8\uB9BC \uD6A8\uACFC."
  - characterId: 3
    characterName: "\uC13C\uD2F0\uB110"
    characterPrefab: {fileID: 7401587327423938050, guid: 7a7c9ed0a2f00d5439c2defdc9fd122f, type: 3}
    characterSprite: {fileID: 21300000, guid: 02a6a8035c9c2524c971fe20df6f2dca, type: 3}
    isOwned: 1
    lockImage: {fileID: 1956881887}
    selectButton: {fileID: 440770434}
    outline: {fileID: 440770431}
    qSkillName: "Q \uC2A4\uD0AC"
    qSkillDesc: "\uC9C0\uBA74\uC5D0 \uC124\uCE58 \uAC00\uB2A5, \uC801\uC774 \uC77C\uC815
      \uBC94\uC704 \uC548\uC5D0 \uB4E4\uC5B4\uC62C \uC2DC \uC790\uB3D9\uC73C\uB85C
      \uB454\uD654 \uAD6C\uC5ED\uC744 \uC0DD\uC131(\uC0AC\uC774\uD37C\uC758 \uC0AC\uC774\uBC84
      \uAC10\uC625\uACFC \uC720\uC0AC) \uC774 \uAD6C\uC5ED\uC774 \uBC1C\uB3D9\uD558\uB294
      \uB3D9\uC548 \uAD6C\uC5ED \uC548\uC5D0 \uC801\uB4E4 \uB610\uB294 \uC544\uAD70\uC740
      \uB454\uD654\uC5D0 \uAC78\uB9BC, \uD30C\uAD34 \uAC00\uB2A5, \uD568\uC815 \uADFC\uCC98\uC5D0\uC120
      \uC801\uB4E4\uC5D0\uAC8C \uC18C\uB9AC \uB4E4\uB9BC, \uCCB4\uB825 40"
    wSkillName: "C \uC2A4\uD0AC"
    wSkillDesc: "C  : C\uD0A4\uB97C \uB204\uB978 \uD6C4 \uC88C\uD074\uB9AD(\uAE38\uAC8C
      \uD22C\uCC99), \uC6B0\uD074\uB9AD(\uC9E7\uAC8C \uD22C\uCC99)\uC744 \uB204\uB974\uBA74
      \uC804\uBC29\uC73C\uB85C \uC2A4\uD0AC\uC744 \uD22C\uCC99\uD574 \uB5A8\uC5B4\uC9C4
      \uACF3\uC5D0 \uBC30\uCE58\uB428 \uC2DC\uC57C\uC5D0 \uBCF4\uC774\uB294 \uC801\uC774
      \uC0AC\uAC70\uB9AC \uC548\uC5D0 \uB4E4\uC5B4\uC624\uBA74 \uD568\uC815\uC774
      \uCE74\uC6B4\uD2B8 \uB2E4\uC6B4 \uD6C4(1\uCD08) \uC8FC\uBCC0 \uC0AC\uAC70\uB9AC
      \uB0B4 \uBAA8\uB4E0 \uC801\uB4E4\uC758 \uC2DC\uC57C\uB97C \uBC1D\uD78C\uB2E4
      (\uCC44\uC784\uBC84\uC758 \uD2B8\uB808\uC774\uB4DC\uB9C8\uD06C\uC640 \uC720\uC0AC)
      \uBC94\uC704 \uB0B4\uC5D0 \uC801\uC774 \uACC4\uC18D \uC788\uB2E4\uBA74 \uC774
      \uD568\uC815\uC740 \uD30C\uAD34\uB418\uAE30 \uC804\uAE4C\uC9C0 \uACC4\uC18D
      \uCE74\uC6B4\uD2B8 \uD6C4 \uBC1C\uB3D9\uB428, \uCCB4\uB825 40,\uCD94\uAC00
      \uC124\uBA85 : \uCC44\uC784\uBC84\uC758 \uD2B8\uB808\uC774\uB4DC\uB9C8\uD06C\uC640
      \uAC19\uC774 \uC77C\uC815 \uBC94\uC704 \uB0B4\uC758 \uC801\uC744 \uC9C1\uC811
      \uCCB4\uD06C\uD569\uB2C8\uB2E4 \uC801\uC774 \uBC18\uACBD\uC5D0 \uB4E4\uC5B4\uC624\uBA74
      \uD2B8\uB808\uC774\uB4DC \uB9C8\uD06C\uCC98\uB7FC \uD568\uC815\uC774 \uC801\uC744
      \uD5A5\uD558\uAC8C \uB418\uACE0 \uC2DC\uC804\uC790\uC5D0\uAC8C \uC548\uB0B4\uAC00
      \uAC11\uB2C8\uB2E4 1\uCD08\uC758 \uCE74\uC6B4\uD2B8\uB2E4\uC6B4 \uD6C4 \uBC18\uACBD
      \uB0B4\uC5D0 \uC5D0\uB108\uC9C0\uB97C \uD37C\uD2B8\uB824 \uBC94\uC704 \uC548\uC758
      \uBAA8\uB4E0 \uC801\uB4E4\uC758 \uC2E4\uB8E8\uC5E3\uC744 \uB178\uCD9C\uC2DC\uD0B5\uB2C8\uB2E4
      \uC5EC\uAE30\uC11C \uC5D0\uB108\uC9C0\uB294 \uC18C\uBC14\uC758 \uB9AC\uCF58\uACFC
      \uC720\uC0AC\uD558\uAC8C \uC810\uC810 \uD37C\uC9C0\uBA70 \uBC94\uC704 \uC548\uAE4C\uC9C0\uC758
      \uC801\uC758 \uC2E4\uB8E8\uC5E3\uC744 \uB178\uCD9C\uC2DC\uD0B5\uB2C8\uB2E4."
    eSkillName: "E \uC2A4\uD0AC"
    eSkillDesc: "\uBCBD\uC5D0 \uC124\uCE58 \uAC00\uB2A5 E\uC2A4\uD0AC\uC744 \uB204\uB978
      \uD6C4 \uC88C\uD074\uB9AD(\uBC30\uCE58) \uB610\uB294 \uC6B0\uD074\uB9AD(\uADF8
      \uB108\uBA38\uC5D0 \uBC30\uCE58) (\uBC14\uC774\uC2A4\uC758 \uC544\uD06C\uC7A5\uBBF8\uC640
      \uC720\uC0AC) \uC0AC\uC6A9\uC2DC \uC8FC\uBCC0 \uBC94\uC704\uC5D0 \uC5D0\uB108\uC9C0\uB97C
      \uBC1C\uC0AC\uD558\uC5EC(\uB370\uB4DC\uB85D\uC758 \uC74C\uD5A5 \uC13C\uC11C\uC640
      \uC720\uC0AC) \uB9DE\uC740 \uC801\uC740 \uB454\uD654 \uC774\uBBF8 \uC801\uC774
      \uB454\uD654\uC5D0 \uAC78\uB838\uB2E4\uBA74 \uC9C4\uD0D5 3\uCD08 \uD574\uB2F9
      \uC2A4\uD0AC\uC740 \uD30C\uAD34 \uAC00\uB2A5 \uD30C\uAD34 \uB420\uC2DC \uC7AC\uC0AC\uC6A9
      \uB300\uAE30\uC2DC\uAC04 1\uBD84, \uC2A4\uD0AC \uBC30\uCE58 \uC0C1\uD0DC\uC5D0\uC11C
      E\uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uD68C\uC218\uAC00\uB2A5(\uD68C\uC218\uC2DC
      \uCFE8\uD0C0\uC784 20\uCD08), \uCCB4\uB825 100"
    rSkillName: "X \uC2A4\uD0AC (\uAD81\uADF9\uAE30)"
    rSkillDesc: "\uC88C\uD074\uB9AD\uC73C\uB85C \uC0AC\uC6A9\uC2DC \uCC28\uC9D5 \uD6C4
      \uC8FC\uBCC0\uC5D0 \uC5D0\uB108\uC9C0 \uD3ED\uBC1C\uC744 \uC77C\uC73C\uCF1C
      \uC790\uC2E0\uC758 \uBAA8\uB4E0 \uC2A4\uD0AC\uC744 \uC7A0\uC2DC\uB3D9\uC548
      \uD30C\uAD34 \uBD88\uAC00 \uC0C1\uD0DC\uB85C \uB9CC\uB4E4\uACE0, \uC2A4\uD0AC
      \uBC94\uC704 \uC9C0\uC5ED\uC5D0 \uC5D0\uB108\uC9C0 \uD53C\uD574 \uC601\uC5ED\uC744
      \uC0DD\uC131\uD574 \uC801\uC5D0\uAC8C \uB454\uD654 + \uD53C\uD574\uB97C \uC900\uB2E4
      \uBC1C\uB85C\uB780\uD2B8 \uAE30\uC900 \uCD08\uB2F9 50\uC758 \uD53C\uD574 (\uBE0C\uB9BC\uC2A4\uD1A4
      \uAD81\uADF9\uAE30\uC640 \uC720\uC0AC)"
  - characterId: 4
    characterName: "\uC5D4\uD2B8\uB9AC"
    characterPrefab: {fileID: 7900068312483294672, guid: 4e96473b7d2b0374885a54802348ce54, type: 3}
    characterSprite: {fileID: 21300000, guid: a5255b51ea07b2949b9b2b1242d3e2fc, type: 3}
    isOwned: 0
    lockImage: {fileID: 34229450}
    selectButton: {fileID: 849671804}
    outline: {fileID: 849671801}
    qSkillName: "\uC554\uC2B5"
    qSkillDesc: "\uBCBD/\uCC9C\uC7A5/\uBC14\uB2E5\uC5D0 \uB2FF\uC73C\uBA74 \uC5F0\uAE30\uAC00
      \uBD84\uCD9C\uB418\uC5B4 \uC7A0\uC2DC\uB3D9\uC548 \uC8FC\uBCC0 \uC2DC\uC57C\uB97C
      \uCC28\uB2E8\uD558\uB294 \uC5F0\uB9C9\uD0C4\uC744 \uC804\uBC29\uC73C\uB85C
      \uD22C\uCC99\uD568."
    wSkillName: "\uAE30\uC2B5 \uC900\uBE44"
    wSkillDesc: "\uC7A0\uC2DC \uB3D9\uC548 \uC6C5\uD06C\uB9AC\uAE30 \uC0C1\uD0DC\uAC00
      \uB418\uC5B4 \uBE60\uB974\uAC8C \uB3CC\uC9C4\uD560 \uC900\uBE44\uB97C \uD568.\n\uC7A0\uC2DC\uD6C4
      \uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5\uC73C\uB85C \uBE60\uB974\uAC8C \uC774\uB3D9\uD568."
    eSkillName: "\uC57C\uC218\uD654"
    eSkillDesc: "\uC7A0\uC2DC \uB3D9\uC548 \uC801\uB4E4\uC5D0\uAC8C \uBCF4\uC774\uC9C0
      \uC54A\uB294 \uC740\uC2E0 \uC0C1\uD0DC\uAC00 \uB418\uACE0 \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD568. \uC801\uC5D0\uAC8C \uC77C\uC815 \uAC70\uB9AC \uC774\uB0B4\uB85C
      \uC811\uADFC\uD560 \uACBD\uC6B0 \uBAA8\uC2B5\uC774 \uBCF4\uC774\uAC8C \uB428."
    rSkillName: "\uC57C\uC218 \uC5EC\uC81C (\uAD81\uADF9\uAE30)"
    rSkillDesc: "\uB2E4\uC74C 6\uD68C\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774 \uC801\uC5D0\uAC8C
      \uD070 \uD53C\uD574\uB97C \uC785\uD788\uB294 \uBC1C\uD1B1 \uBC1C\uC0AC \uACF5\uACA9\uC73C\uB85C
      \uB300\uCCB4\uB428.\n\uC870\uC900\uD558\uC5EC \uACF5\uACA9\uD560 \uACBD\uC6B0
      \uB0A8\uC740 \uBC1C\uD1B1\uC744 \uBAA8\uB450 \uBC1C\uC0AC\uD568."

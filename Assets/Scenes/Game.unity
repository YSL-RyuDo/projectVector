    roleImage: {fileID: 21300000, guid: 7bbdfdafe460b314a87ec5f4171689f2, type: 3}
    cSkill:
      skillKey: C
      skillIcon: {fileID: 21300000, guid: df7eb4f57a66a0945b1be210718d589e, type: 3}
      skillName: "\uAD50\uB780 \uD568\uC815"
      skillDescription: "\uD568\uC815\uC744 \uD22C\uCC99\uD558\uC5EC \uC124\uCE58.\n\uC124\uCE58
        \uD6C4 \uC0AC\uC6A9\uD0A4\uB97C \uB20C\uB7EC\n\uAE30\uBCF8 \uD53C\uC2A4\uD1A8
        \uD0C0\uACA9 \uC18C\uB9AC \uBC1C\uC0B0"
    qSkill:
      skillKey: Q
      skillIcon: {fileID: 21300000, guid: 1a1860e469c38bb499b98a02d246b08d, type: 3}
      skillName: "\uB2AA \uD568\uC815"
      skillDescription: "\uD568\uC815\uC744 \uD22C\uCC99\uD558\uC5EC \uBCBD\uC5D0
        \uB2FF\uC73C\uBA74 \uD295\uAE30\uACE0\n\uBC14\uB2E5\uC5D0 \uB2FF\uC73C\uBA74
        \uADF8\uC790\uB9AC\uC5D0 \uC804\uAC1C\n\uC0C1\uB300\uB294 \uB2AA\uC5D0\uC11C
        \uC2AC\uB85C\uC6B0 \uD6A8\uACFC."
    eSkill:
      skillKey: E
      skillIcon: {fileID: 21300000, guid: d688d500531a83847a308aeab42cb2ca, type: 3}
      skillName: "\uC5F0\uB9C9"
      skillDescription: "\uC911\uC559\uC5D0 \uBBF8\uB2C8 \uB9F5\uC744 \uB744\uC6B0\uACE0
        \uC88C\uD074\uB9AD\uD558\uC5EC\n\uC704\uCE58\uB97C \uC815\uD558\uACE0 \uC6B0\uD074\uB9AD\uC73C\uB85C
        \n\uD574\uB2F9 \uC704\uCE58\uC5D0 \uC5F0\uB9C9 \uD22C\uD558"
    xSkill:
      skillKey: X
      skillIcon: {fileID: 21300000, guid: 3431a3f7e70fbd343af920e9749c68d1, type: 3}
      skillName: "\uBABD\uD658\uC758 \uC232"
      skillDescription: "\uC2A4\uD0AC \uC2DC\uC804 \uC2DC \uC790\uC2E0\uC758 \uC8FC\uBCC0\uC73C\uB85C
        \uC548\uAC1C\uB97C \uBFCC\uB824\n\uC601\uC5ED\uC744 \uC804\uAC1C\uD558\uBA70
        \uC2DC\uC57C\uB97C \uBC29\uD574\uD558\uACE0\n\uC0C1\uB300\uAC00 \uC9C4\uC785
        \uC2DC \uC2DD\uBCC4 \uB80C\uB354\uB9C1\uC744 \uCC28\uBCC4\uD558\uBA70\n\uC0AC\uC6B4\uB4DC
        \uC6B8\uB9BC \uD6A8\uACFC"
  - characterId: 2
    characterName: "\uC13C\uD2F0\uB110"
    characterImage: {fileID: 21300000, guid: a132300c40dbc6b4aaa51cec0092f680, type: 3}
    roleName: "\uC13C\uD2F0\uB110"
    roleImage: {fileID: 21300000, guid: 56c2a3a34b52a6b4fa8d273f65f72482, type: 3}
    cSkill:
      skillKey: C
      skillIcon: {fileID: 21300000, guid: ce900c84ce1566a4ba206a8b4acd5925, type: 3}
      skillName: "C\uC2A4\uD0AC"
      skillDescription: "\uC804\uBC29\uC73C\uB85C \uC2A4\uD0AC\uC744 \uD22C\uCC99\uD574
        \uB5A8\uC5B4\uC9C4 \uACF3\uC5D0 \uBC30\uCE58\r\n\uC2DC\uC57C\uC5D0 \uBCF4\uC774\uB294
        \uC801\uC774 \uC0AC\uAC70\uB9AC \uC548\uC5D0 \uB4E4\uC5B4\uC624\uBA74\r\n\uD568\uC815\uC774
        \uCE74\uC6B4\uD2B8 \uB2E4\uC6B4 \uD6C4 \uC8FC\uBCC0 \uC0AC\uAC70\uB9AC \uB0B4
        \uBAA8\uB4E0 \uC801\uB4E4\uC758 \uC2DC\uC57C\uB97C \uBC1D\uD78C\uB2E4\r\n\uBC94\uC704
        \uB0B4\uC5D0 \uC801\uC774 \uACC4\uC18D \uC788\uB2E4\uBA74 \uC774 \uD568\uC815\uC740
        \uD30C\uAD34\uB418\uAE30 \uC804\uAE4C\uC9C0 \uACC4\uC18D \uCE74\uC6B4\uD2B8
        \uD6C4 \uBC1C\uB3D9\uB428"
    qSkill:
      skillKey: Q
      skillIcon: {fileID: 21300000, guid: f7ef6f51f674fbd438b39fb00a55640d, type: 3}
      skillName: "Q\uC2A4\uD0AC"
      skillDescription: "\uC9C0\uBA74\uC5D0 \uC124\uCE58 \uAC00\uB2A5, \uC801\uC774
        \uC77C\uC815 \uBC94\uC704 \uC548\uC5D0 \uB4E4\uC5B4\uC62C \uC2DC \uC790\uB3D9\uC73C\uB85C
        \uB454\uD654 \uAD6C\uC5ED\uC744 \uC0DD\uC131\n\uC774 \uAD6C\uC5ED\uC774 \uBC1C\uB3D9\uD558\uB294
        \uB3D9\uC548 \uAD6C\uC5ED \uC548\uC5D0 \uC801\uB4E4 \uB610\uB294 \uC544\uAD70\uC740
        \uB454\uD654\uC5D0 \uAC78\uB9BC, \uD30C\uAD34 \uAC00\uB2A5, \uD568\uC815
        \uADFC\uCC98\uC5D0\uC120 \uC801\uB4E4\uC5D0\uAC8C \uC18C\uB9AC \uB4E4\uB9BC"
    eSkill:
      skillKey: E
      skillIcon: {fileID: 21300000, guid: 7bd2477c4e4ec594db0297a3273903b1, type: 3}
      skillName: "E\uC2A4\uD0AC"
      skillDescription: "\uC0AC\uC6A9\uC2DC \uC8FC\uBCC0 \uBC94\uC704\uC5D0 \uC5D0\uB108\uC9C0\uB97C
        \uBC1C\uC0AC\uD558\uC5EC \uB9DE\uC740 \uC801\uC740 \uB454\uD654 \uC774\uBBF8
        \uC801\uC774 \uB454\uD654\uC5D0 \uAC78\uB838\uB2E4\uBA74 \uC9C4\uD0D5 3\uCD08
        \uD574\uB2F9 \uC2A4\uD0AC\uC740 \uD30C\uAD34 \uAC00\uB2A5 \uD30C\uAD34 \uB420\uC2DC
        \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 1\uBD84, \uC2A4\uD0AC \uBC30\uCE58
        \uC0C1\uD0DC\uC5D0\uC11C E\uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uD68C\uC218\uAC00\uB2A5"
    xSkill:
      skillKey: X
      skillIcon: {fileID: 21300000, guid: bc7c6e0f93fb7d749950dc91442a3b8e, type: 3}
      skillName: "X\uC2A4\uD0AC"
      skillDescription: "\uC88C\uD074\uB9AD\uC73C\uB85C \uC0AC\uC6A9\uC2DC \uCC28\uC9D5
        \uD6C4 \uC8FC\uBCC0\uC5D0 \uC5D0\uB108\uC9C0 \uD3ED\uBC1C\uC744 \uC77C\uC73C\uCF1C
        \uC790\uC2E0\uC758 \uBAA8\uB4E0 \uC2A4\uD0AC\uC744 \uC7A0\uC2DC\uB3D9\uC548
        \uD30C\uAD34 \uBD88\uAC00 \uC0C1\uD0DC\uB85C \uB9CC\uB4E4\uACE0, \uC2A4\uD0AC
        \uBC94\uC704 \uC9C0\uC5ED\uC5D0 \uC5D0\uB108\uC9C0 \uD53C\uD574 \uC601\uC5ED\uC744
        \uC0DD\uC131\uD574 \uC801\uC5D0\uAC8C \uB454\uD654 + \uD53C\uD574\uB97C \uC900\uB2E4
        \uBC1C\uB85C\uB780\uD2B8 \uAE30\uC900 \uCD08\uB2F9 50\uC758 \uD53C\uD574"
  - characterId: 3
    characterName: "\uB4C0\uC5BC\uB9AC\uC2A4\uD2B8"
    characterImage: {fileID: 21300000, guid: b241a5f4fe098914e93d46ce36ac92be, type: 3}
    roleName: "\uB4C0\uC5BC\uB9AC\uC2A4\uD2B8"
    roleImage: {fileID: 21300000, guid: 1416eedb697152b4db08f2d9302a9754, type: 3}
    cSkill:
      skillKey: C
      skillIcon: {fileID: 21300000, guid: 62592dabc79318b40a907c9dae9c72e9, type: 3}
      skillName: "\uAE30\uC2B5 \uC900\uBE44"
      skillDescription: "\uC7A0\uC2DC\uB3D9\uC548 \uC6C5\uD06C\uB9AC\uAE30 \uC0C1\uD0DC\uAC00
        \uB418\uC5B4 \uBE60\uB974\uAC8C \uB3CC\uC9C4 \uC900\uBE44\n\uC7A0\uC2DC\uD6C4
        \uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5\uC73C\uB85C \uBE60\uB974\uAC8C \uC774\uB3D9"
    qSkill:
      skillKey: Q
      skillIcon: {fileID: 21300000, guid: 7faf0d04c8b90fc42b3dcbd0365f57e4, type: 3}
      skillName: "\uC554\uC2B5"
      skillDescription: "\uBCBD/\uCC9C\uC7A5/\uBC14\uB2E5\uC5D0 \uB2FF\uC73C\uBA74
        \uC5F0\uAE30\uAC00 \uBD84\uCD9C\uB418\uC5B4\n\uC7A0\uC2DC\uB3D9\uC548 \uC8FC\uBCC0
        \uC2DC\uC57C\uB97C \uCC28\uB2E8\uD558\uB294 \uC5F0\uB9C9\uD0C4 \uC804\uBC29
        \uD22C\uCC99"
    eSkill:
      skillKey: E
      skillIcon: {fileID: 21300000, guid: d4c7d6af3737e4e4c869358df7e9a6cd, type: 3}
      skillName: "\uC57C\uC218\uC640"
      skillDescription: "\uC7A0\uC2DC\uB3D9\uC548 \uC801\uB4E4\uC5D0\uAC8C \uBCF4\uC774\uC9C0
        \uC54A\uB294 \uC740\uC2E0 \uC0C1\uD0DC\uAC00 \uB418\uACE0 \uC774\uB3D9\uC18D\uB3C4
        \uC99D\uAC00\n\uC801\uC5D0\uAC8C \uC77C\uC815 \uAC70\uB9AC \uC774\uB0B4\uB85C
        \uC811\uADFC\uD560 \uACBD\uC6B0 \uBAA8\uC2B5\uC774 \uBCF4\uC784\n\uACF5\uACA9
        \uBC0F \uC2A4\uD0AC \uC0AC\uC6A9\uC2DC \uC2A4\uD0AC \uD6A8\uACFC \uD574\uC81C"
    xSkill:
      skillKey: X
      skillIcon: {fileID: 21300000, guid: 8eba7244f734ad945a4e533f648adea3, type: 3}
      skillName: "\uC57C\uC218 \uC5EC\uC81C"
      skillDescription: "\uB2E4\uC74C 6\uD68C\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774
        \uC801\uC5D0\uAC8C \uD070 \uD53C\uD574\uB97C \uC785\uD788\uB294 \uBC1C\uC0AC
        \uACF5\uACA9 \uB300\uCCB4\n\uC870\uC900\uD558\uC5EC \uACF5\uACA9 \uC2DC \uB0A8\uC740
        \uBC1C\uD1B1 \uBAA8\uB450 \uBC1C\uC0AC"

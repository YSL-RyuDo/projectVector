  characterId: 2
  characterSprite: {fileID: 21300000, guid: 02a6a8035c9c2524c971fe20df6f2dca, type: 3}
  characterName: "\uD558\uC740"
  gender: "\uC5EC"
  birthday: "6\uC6D4 2\uC77C"
  stature: 158cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uD574\uD0B9, \uC7A0"
  eatingHabits: "\uCEF5\uB77C\uBA74"
  individuality: "\"\uD574\uD0B9\uC774\uC694? \uBCC4\uAC70 \uC5C6\uC5B4\uC694. \uADF8\uB0E5
    \uBC29\uD654\uBCBD \uD2C8\uC0C8\uB85C \uC190\uAC00\uB77D \uBA87 \uBC88 \uD295\uACA8\uC8FC\uBA74
    \uB05D... \uC544, \uC124\uBA85\uD558\uB294 \uAC8C \uB354 \uADC0\uCC2E\uB2E4.\""
  intro: "\uAC70\uC810 \uBC29\uC5B4 \uBC0F \uC544\uAD70 \uC9C0\uC6D0 \uC804\uBB38\uAC00.
    \uCD5C\uC804\uBC29\uC774\uB098 \uC8FC\uC694 \uAC70\uC810\uC5D0 \uC124\uCE58\uD615
    \uBC29\uC5B4 \uC7A5\uBE44\uC640 \uAC10\uC9C0 \uC13C\uC11C\uB97C \uC124\uCE58\uD558\uC5EC
    \uC801\uC758 \uC6B0\uD68C \uBC0F \uB3CC\uD30C\uB97C \uC644\uBCBD\uD788 \uC5B5\uC81C\uD55C\uB2E4.
    \uBCF8\uC778\uC774 \uC9C1\uC811 \uB2E8\uB2E8\uD55C \uBCBD \uC5ED\uD560\uC744
    \uB9E1\uC544 \uC544\uAD70\uC774 \uB9C8\uC74C \uB193\uACE0 \uD654\uB825\uC744
    \uC9D1\uC911\uD560 \uC218 \uC788\uB294 \uC548\uC804\uC9C0\uB300\uB97C \uB9CC\uB4E4\uC5B4\uB0B8\uB2E4."
  observationNotes: "\uC815\uBCF4\uC804 \uBC0F \uC0DD\uBB3C\uD559 \uC9C0\uB3C4 \uC601\uC5ED\uC5D0\uC11C
    \uC0DD\uCCB4 \uD574\uCEE4 \uBC0F \uAD50\uAD00 \uC5ED\uD560\uC744 \uB9E1\uB294
    \uD558\uC740\uC740 \uADC0\uCC2E\uC74C\uC774 \uD328\uC2DC\uBE0C\uC778 \uAC8C\uC73C\uB978
    \uCC9C\uC7AC \uD0DC\uC0DD\uC758 \"\uB098\uC911\uC5D0 \uC5F0\uB77D\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4\"\uB97C
    \uC785\uC5D0 \uB2EC\uACE0 \uC0AC\uB294 \uC758\uC678\uC758 \uC9D1\uCC29 \uC601\uC5ED\uC5D0\uC11C
    \uB2EC\uD33D\uC774 \uC9D1\uC0AC \uC5ED\uD560\uC744 \uB9E1\uB294 \uD558\uC740\uC740
    \uB8F8\uBA54\uC774\uD2B8 '\uD551\uD551\uC774'\uB97C \uBAA8\uC2DC\uB294 \uC0DD\uBB3C\uD559\uC790
    \uD0DC\uC0DD\uC758 \uAD00\uC2EC \uBD84\uC57C\uAC00 \uB098\uC624\uBA74 \uB7A9\uD558\uB4EF
    \uBB38\uC7A5\uC744 \uD3ED\uBC1C\uC2DC\uD0A4\uB294 \uC131\uACA9\uC744 \uAC00\uC9C0\uACE0
    \uC788\uB2E4."

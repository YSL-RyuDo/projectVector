  characterId: 3
  characterSprite: {fileID: 21300000, guid: a5255b51ea07b2949b9b2b1242d3e2fc, type: 3}
  characterName: "\uB3C4\uD76C"
  gender: "\uC5EC"
  birthday: "11\uC6D4 7\uC77C"
  stature: 152cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uC6B4\uB3D9"
  eatingHabits: "\uACE0\uAE30, \uD504\uB85C\uD2F4 \uC250\uC774\uD06C"
  individuality: "\"\uD5E4\uD5E4, \uB3CC\uACA9\uC740 \uB098\uD55C\uD14C \uB9E1\uACA8!
    \uB0B4 \uB4A4\uC5D0 \uBC14\uC9DD \uBD99\uC5B4\uC788\uC73C\uBA74 \uD138\uB05D
    \uD558\uB098 \uBABB \uAC74\uB4DC\uB9AC\uAC8C \uD574\uC904\uAC8C!\""
  intro: "\uC555\uB3C4\uC801\uC778 \uC21C\uBC1C\uB825\uC73C\uB85C \uC801\uC9C4 \uD55C\uBCF5\uD310\uC5D0
    \uAE30\uC2B5 \uCE68\uD22C\uD558\uB294 \uC120\uBD09\uC7A5. \uBE60\uB978 \uC774\uB3D9\uAE30\uC640
    \uD654\uB824\uD55C \uC0AC\uACA9\uC220\uB85C \uC801\uC758 \uBC29\uC5B4\uC120\uC744
    \uB2E8\uC228\uC5D0 \uBB34\uB108\uB728\uB9B0\uB2E4. \uC704\uD5D8\uD55C \uC0C1\uD669\uC77C\uC218\uB85D
    \uC624\uD788\uB824 \uD765\uBD84\uD558\uBA70, \uC801\uC758 \uD5C8\uC810\uC744
    \uCC14\uB7EC \uCCAB \uBC88\uC9F8 \uAE30\uC808(First Kill)\uC744 \uB530\uB0B4\uB294
    \uB2A5\uB825\uC774 \uB3C5\uBCF4\uC801\uC774\uB2E4."
  observationNotes: "\uC804\uD22C \uC120\uBD09 \uBC0F \uD0F1\uD0B9 \uC601\uC5ED\uC5D0\uC11C
    \uCD5C\uC804\uBC29 \uB3CC\uACA9\uC7A5 \uC5ED\uD560\uC744 \uB9E1\uB294 \uB3C4\uD76C\uB294
    \uC791\uC740 \uCCB4\uAD6C\uC758 \uACE0\uC591\uC774 \uADC0 \uC218\uC778 \uD0DC\uC0DD\uC758
    \uBC1D\uACE0 \uC6A9\uAC10\uD558\uBA70 \uAC81 \uC5C6\uC774 \uC81C\uC77C \uBA3C\uC800
    \uB6F0\uC5B4\uB4DC\uB294 \uC131\uACA9\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4 \uB300\uC778
    \uAD00\uACC4 \uC601\uC5ED\uC5D0\uC11C \uD574\uD53C \uBC14\uC774\uB7EC\uC2A4 \uC5ED\uD560\uC744
    \uB9E1\uB294 \uB3C4\uD76C\uB294 \uB0AF\uAC00\uB9BC\uC774 \uC804\uD600 \uC5C6\uB294
    \uC0AC\uAD50\uC655 \uD0DC\uC0DD\uC758 \uB204\uAD6C\uC640\uB3C4 \uAE08\uBC29 \uCE5C\uAD6C\uAC00
    \uB418\uACE0 \uBD84\uC704\uAE30\uB97C \uBC1D\uAC8C \uB9CC\uB4DC\uB294 \uC131\uACA9\uC744
    \uAC00\uC9C0\uACE0 \uC788\uB2E4."

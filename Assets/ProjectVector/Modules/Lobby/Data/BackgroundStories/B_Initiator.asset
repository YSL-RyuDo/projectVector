  characterId: 0
  characterSprite: {fileID: 21300000, guid: dc9bf2d90dd707d40a8b7a6b5f9f3eb9, type: 3}
  characterName: "\uD55C\uBCC4"
  gender: "\uC5EC"
  birthday: "9\uC6D4 24\uC77C"
  stature: 171cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uC7A5\uBE44 \uC81C\uC791, \uC6A9\uC811"
  eatingHabits: "\uD06C\uB9BC \uCE58\uC988, \uACE0\uAD6C\uB9C8 \uACE0\uB85C\uCF00"
  individuality: "\"\uC2A4\uD30C\uD06C \uC880 \uD284\uB2E4\uACE0 \uB180\uB77C\uC9C0
    \uB9C8! \uBA85\uC0C9\uC774 \uC804\uAE30 \uC7A5\uBE44\uC778\uB370 \uC774 \uC815\uB3C4
    \uC790\uADF9\uC740 \uAE30\uBCF8\uC774\uAC70\uB4E0?\""
  intro: "\uC804\uC7A5\uC758 \uC870\uB825\uC790, \uC801\uAD70\uC758 \uC704\uCE58\uB97C
    \uD30C\uC545\uD558\uB294 \uAC83\uC774 \uD2B9\uAE30\uC774\uB2E4.\n\uD14C\uC774\uC800
    \uB4DC\uB860\uC744 \uC774\uC6A9\uD574 \uC804\uC7A5\uC758 \uC2DC\uC57C \uD30C\uC545\uC744
    \uD55C\uB2E4.\n\uB610\uD55C \uC804\uAE30 \uACF5\uACA9\uC744 \uD1B5\uD574 \uC9C1\uC811\uC801\uC778
    \uACF5\uACA9\uB3C4 \uAC00\uB2A5\uD558\uB2E4."
  observationNotes: "\uC7A5\uBE44 \uC815\uBE44 \uBC0F \uAE30\uC220 \uC9C0\uC6D0 \uC601\uC5ED\uC5D0\uC11C
    \uACF5\uB300\uC0DD \uBA54\uCE74\uB2C9 \uC5ED\uD560\uC744 \uB9E1\uB294 \uD55C\uBCC4\uC740
    \uAE30\uB984 \uB0C4\uC0C8\uC640 \uC2A4\uD30C\uD06C\uB97C \uC0AC\uB791\uD558\uB294
    \uC5D4\uC9C0\uB2C8\uC5B4 \uD0DC\uC0DD\uC758 \uC2DC\uC6D0\uC2DC\uC6D0\uD558\uACE0
    \uB2F9\uCC2C \uC194\uC9C1 \uB2F4\uBC31\uD55C \uC131\uACA9\uC744 \uAC00\uC9C0\uACE0
    \uC788\uB2E4\uD300 \uB0B4 \uC785\uC9C0 \uC601\uC5ED\uC5D0\uC11C \uBD84\uC704\uAE30
    \uBA54\uC774\uCEE4 \uBC0F \uD589\uB3D9\uB300\uC7A5 \uC5ED\uD560\uC744 \uB9E1\uB294
    \uD55C\uBCC4\uC740 \uC9C1\uAD00\uC801\uC774\uACE0 \uC5F4\uC815\uC774 \uB118\uCE58\uB294
    \uACF5\uD559\uB3C4 \uD0DC\uC0DD\uC758 \uB3D9\uB8CC\uC758 \uBB34\uAE30\uAC00 \uACE0\uC7A5
    \uB098\uBA74 \uC81C\uC77C \uBA3C\uC800 \uC5F0\uC7A5\uC744 \uB4E4\uACE0 \uB6F0\uC5B4\uC624\uB294
    \uC131\uACA9\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4."

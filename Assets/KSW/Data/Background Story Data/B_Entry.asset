  characterId: 3
  characterSprite: {fileID: 21300000, guid: a5255b51ea07b2949b9b2b1242d3e2fc, type: 3}
  characterName: "\uC5D4\uD2B8\uB9AC"
  gender: "\uC5EC"
  birthday: "9\uC6D4 1\uC77C"
  stature: 155cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uC2A4\uCF00\uC774\uD2B8\uBCF4\uB4DC, \uC74C\uC545 \uAC10\uC0C1"
  eatingHabits: "\uC824\uB9AC, \uC0AC\uD0D5\uC744 \uD56D\uC0C1 \uC8FC\uBA38\uB2C8\uC5D0
    \uB123\uACE0 \uB2E4\uB2C8\uBA70 \uB04A\uC784\uC5C6\uC774 \uBA39\uC74C"
  individuality: "\uBE44\uCF1C! \uC81C\uC77C \uBE60\uB978 \uAC74 \uB098\uB2C8\uAE4C
    \uB2E4\uB4E4 \uB0B4 \uB4A4\uB098 \uC798 \uB530\uB77C\uC624\uB77C\uACE0!"
  intro: "\uC555\uB3C4\uC801\uC778 \uC21C\uBC1C\uB825\uC73C\uB85C \uC801\uC9C4 \uD55C\uBCF5\uD310\uC5D0
    \uAE30\uC2B5 \uCE68\uD22C\uD558\uB294 \uC2DC\uC800\uC2A4\uC758 \uC120\uBD09\uC7A5.
    \uBE60\uB978 \uC774\uB3D9\uAE30\uC640 \uD654\uB824\uD55C \uC0AC\uACA9\uC220\uB85C
    \uC801\uC758 \uBC29\uC5B4\uC120\uC744 \uB2E8\uC228\uC5D0 \uBB34\uB108\uB728\uB9B0\uB2E4.
    \uC704\uD5D8\uD55C \uC0C1\uD669\uC77C\uC218\uB85D \uC624\uD788\uB824 \uD765\uBD84\uD558\uBA70,
    \uC801\uC758 \uD5C8\uC810\uC744 \uCC14\uB7EC \uCCAB \uBC88\uC9F8 \uAE30\uC808(First
    Kill)\uC744 \uB530\uB0B4\uB294 \uB2A5\uB825\uC774 \uB3C5\uBCF4\uC801\uC774\uB2E4."
  observationNotes: "\uD300 \uB0B4\uC5D0\uC11C \uAC00\uC7A5 \uB6F0\uC5B4\uB09C \uC21C\uBC1C\uB825\uACFC
    \uAE30\uB3D9\uC131\uC744 \uAC00\uC84C\uB2E4. \uACFC\uAC10\uD558\uB2E4 \uBABB\uD574
    \uBB34\uBAA8\uD574 \uBCF4\uC774\uB294 \uB3CC\uC9C4\uC744 \uAC10\uD589\uD560 \uB54C\uAC00
    \uB9CE\uC544 \uD300\uC6D0\uB4E4\uC744 \uB180\uB77C\uAC8C \uD558\uC9C0\uB9CC,
    \uC0AC\uACA9 \uC2E4\uB825\uACFC \uBCF8\uB2A5\uC801\uC778 \uAC10\uAC01\uC73C\uB85C
    \uACB0\uACFC\uB97C \uB9CC\uB4E4\uC5B4\uB0B8\uB2E4. \uB3CC\uBC1C \uD589\uB3D9\uC744
    \uC790\uC8FC \uD558\uBBC0\uB85C \uC804\uB2F4 \uCF00\uC5B4\uAC00 \uD544\uC694\uD558\uB2E4."

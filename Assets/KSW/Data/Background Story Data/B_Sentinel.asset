  characterId: 2
  characterSprite: {fileID: 21300000, guid: 02a6a8035c9c2524c971fe20df6f2dca, type: 3}
  characterName: "\uC13C\uD2F0\uB110"
  gender: "\uC5EC"
  birthday: "11\uC6D4 13\uC77C"
  stature: 166cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uB2EC\uB9AC\uAE30, \uAD8C\uBC95, \uC218\uB828"
  eatingHabits: "\uC804\uC220 \uC9C0\uD615 \uBD84\uC11D, \uD504\uB85C\uADF8\uB798\uBC0D,
    \uC74C\uC545 \uAC10\uC0C1"
  individuality: "\uB0B4\uAC00 \uBC29\uC5B4\uD574 \uC904\uAC8C"
  intro: "\uC2DC\uC800\uC2A4 \uC2E4\uD589\uD300\uC758 \uAC70\uC810 \uBC29\uC5B4 \uBC0F
    \uC544\uAD70 \uC9C0\uC6D0 \uC804\uBB38\uAC00. \uCD5C\uC804\uBC29\uC774\uB098
    \uC8FC\uC694 \uAC70\uC810\uC5D0 \uC124\uCE58\uD615 \uBC29\uC5B4 \uC7A5\uBE44\uC640
    \uAC10\uC9C0 \uC13C\uC11C\uB97C \uC124\uCE58\uD558\uC5EC \uC801\uC758 \uC6B0\uD68C
    \uBC0F \uB3CC\uD30C\uB97C \uC644\uBCBD\uD788 \uC5B5\uC81C\uD55C\uB2E4. \uBCF8\uC778\uC774
    \uC9C1\uC811 \uB2E8\uB2E8\uD55C \uBCBD \uC5ED\uD560\uC744 \uB9E1\uC544 \uC544\uAD70\uC774
    \uB9C8\uC74C \uB193\uACE0 \uD654\uB825\uC744 \uC9D1\uC911\uD560 \uC218 \uC788\uB294
    \uC548\uC804\uC9C0\uB300\uB97C \uB9CC\uB4E4\uC5B4\uB0B8\uB2E4."
  observationNotes: "\uB9D0\uC218\uAC00 \uC801\uACE0 \uB2E8\uC815\uD55C \uD0DC\uB3C4\uB97C
    \uC720\uC9C0\uD558\uC9C0\uB9CC, \uC784\uBB34\uAC00 \uC2DC\uC791\uB418\uBA74 \uB204\uAD6C\uBCF4\uB2E4
    \uAF3C\uAF3C\uD558\uAC8C \uC13C\uC11C\uC640 \uC9C4\uD615\uC744 \uCCB4\uD06C\uD55C\uB2E4.
    \uC801\uC758 \uC608\uC0C1 \uC9C4\uC785\uB85C\uB97C \uC0AC\uC804\uC5D0 \uCC28\uB2E8\uD558\uB294
    \uB2A5\uB825\uC774 \uD0C1\uC6D4\uD558\uBA70, \uD300\uC6D0\uC774 \uC704\uD5D8\uD574\uC9C0\uBA74
    \uB9DD\uC124\uC784 \uC5C6\uC774 \uBC29\uC5B4\uB9C9\uC744 \uB358\uC838 \uBCF4\uD638\uD560
    \uB9CC\uD07C \uAC15\uD55C \uCC45\uC784\uAC10\uC744 \uC9C0\uB2C8\uACE0 \uC788\uB2E4."

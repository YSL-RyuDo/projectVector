  m_Name: B_Initiator
  m_EditorClassIdentifier: Assembly-CSharp::BackgroundStoryData
  characterName: "\uC774\uB2C8\uC2DC\uC5D0\uC774\uD130"
  gender: "\uC5EC"
  birthday: "8\uC6D4 15\uC77C"
  stature: 166cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uB2EC\uB9AC\uAE30, \uAD8C\uBC95, \uC218\uB828"
  eatingHabits: "\uBB50\uB4E0 \uC798 \uBA39\uC73C\uBA70, \uC591\uC774 \uB9CE\uC740
    \uAC00\uC815\uC2DD\uC744 \uC88B\uC544\uD558\uB294\uB370 \uC608\uB97C \uB4E4\uBA74
    \uB3C8\uCE74\uCE20 \uB36E\uBC25"
  individuality: "\uBD88\uB9CC \uC788\uC5B4? \uADF8\uB7FC \uC8FC\uBA39\uC73C\uB85C
    \uB9D0\uD574\uBD10"
  intro: "\uC2DC\uC800\uC2A4 \uC77C\uC120 \uC804\uC0AC, \uC2E4\uD589\uD300 \uB3CC\uACA9\uB300\uC7A5\n\uD504\uB808\uD1A4
    \uAC70\uB9AC\uC5D0\uC11C \uC790\uB780 \uD070\uC5B8\uB2C8,\n\uBC14\uB2E5 \uC778\uC0DD\uC758
    \uC5B4\uB450\uC6B4 \uBA74\uC744 \uBAA8\uB450 \uACBD\uD5D8\uD558\uACE0 \uC2DC\uC800\uC2A4\uC5D0
    \uD569\uB958, \uBAA8\uB450\uAC00 \uB354 \uB098\uC740 \uC0B6\uC744 \uC0B4 \uC218
    \uC788\uB3C4\uB85D \uC2F8\uC6B0\uAE30\uB85C \uACB0\uC2EC\uD588\uB2E4.\n\uB2E4\uC18C
    \uBB34\uBAA8\uD558\uAC8C \uD589\uB3D9\uD558\uC9C0\uB9CC, \uADF8\uB140\uC758 \uC804\uD22C\uB825\uACFC
    \uCE74\uB9AC\uC2A4\uB9C8\uB294 \uC2DC\uC800\uC2A4 \uC2E4\uD589 \uC791\uC804\uC5D0\uC11C
    \uC5C6\uC5B4\uC11C\uB294 \uC548 \uB420 \uD575\uC2EC \uC804\uB825\uC774\uB2E4."
  observationNotes: "\uBC0D\uC740 \uC785\uACFC \uBAB8\uC774 \uC26C\uC9C0 \uC54A\uACE0,
    \uB2EC\uB9AC\uBA74\uC11C \uB9CC\uB098\uB294 \uC0AC\uB78C\uB9C8\uB2E4 \uC778\uC0AC\uB97C
    \uAC74\uB128\uB2E4. '\uC778\uAC04 \uAD00\uACC4'\uC5D0 \uB300\uD55C \uAC10\uC815\uACFC
    \uAE30\uC5B5\uC774 \uD48D\uBD80\uD558\uC5EC, \uC7A5\uAE30\uC801\uC73C\uB85C \uBCF4\uBA74
    \uB54C\uB54C\uB85C \uBB38\uC81C\uAC00 \uB420 \uC218\uB3C4 \uC788\uB2E4."
  characterId: 0
  characterSprite: {fileID: 21300000, guid: dc9bf2d90dd707d40a8b7a6b5f9f3eb9, type: 3}

  characterSprite: {fileID: 21300000, guid: 081b60c7a99a3d9408f5b3a91dcc32c5, type: 3}
  characterName: "\uC138\uB9B0"
  gender: "\uC5EC"
  birthday: "3\uC6D4 8\uC77C"
  stature: 169cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uB3C5\uC11C"
  eatingHabits: "\uBC24 \uD2F0\uB77C\uBBF8\uC218"
  individuality: "\"\uC800, \uC800\uAE30... \uD639\uC2DC \uC9C8\uBB38 \uC788\uC73C\uC2E0\uAC00\uC694?
    \uC5B4, \uC5B4\uB824\uC6B4 \uACF5\uC2DD\uC774\uB77C\uB3C4 \uCC28\uADFC\uCC28\uADFC
    \uC124\uBA85\uD574 \uB4DC\uB9B4\uAC8C\uC694!\""
  intro: "\uC804\uC7A5\uC758 \uC2DC\uC57C\uC640 \uAD6C\uC5ED\uC744 \uC9C0\uBC30\uD558\uB294
    \uC804\uC220 \uD1B5\uC81C\uAD00. \uD2B9\uC218 \uC5F0\uB9C9 \uC7A5\uCE58\uC640
    \uAC00\uC2A4 \uC7A5\uBE44\uB97C \uD65C\uC6A9\uD574 \uC801\uC758 \uC2DC\uC57C\uB97C
    \uC644\uC804 \uCC28\uB2E8\uD558\uACE0 \uC544\uAD70\uC758 \uC774\uB3D9 \uACBD\uB85C\uB97C
    \uD655\uBCF4\uD55C\uB2E4. \uC804\uC7A5 \uC804\uCCB4\uC758 \uC9C0\uD615\uC744
    \uD55C\uB208\uC5D0 \uD30C\uC545\uD558\uBA70, \uC0C1\uB300\uC758 \uC2EC\uB9AC\uB97C
    \uC77D\uACE0 \uD310\uC744 \uC124\uACC4\uD558\uB294 \uC9C0\uB7B5\uAC00 \uC2A4\uD0C0\uC77C\uC774\uB2E4."
  observationNotes: "\uC9C0\uC2DD\uACFC \uD559\uC220 \uC5F0\uAD6C \uC601\uC5ED\uC5D0\uC11C
    \uACFC\uD559 \uC870\uB825\uC790 \uBC0F \uBD84\uC11D\uAD00 \uC5ED\uD560\uC744
    \uB9E1\uB294 \uC138\uB9B0\uC740 \uADF9\uB3C4\uB85C \uC18C\uC2EC\uD55C \uD559\uAD6C\uD30C
    \uC5F0\uAD6C\uC6D0 \uD0DC\uC0DD\uC758 \uBA38\uBB47\uAC70\uB9AC\uBA74\uC11C\uB3C4
    \uD575\uC2EC\uC744 \uCC0C\uB974\uB294 \uC218\uB3D9\uC801\uC778 \uC131\uACA9\uC744
    \uAC00\uC9C0\uACE0 \uC788\uB2E4 \uC8FC\uC778\uACF5\uACFC\uC758 \uAD00\uACC4 \uBC0F
    \uC720\uB300 \uC601\uC5ED\uC5D0\uC11C \uD30C\uD2B8\uB108 \uBC0F \uC870\uB825\uC790
    \uC5ED\uD560\uC744 \uB9E1\uB294 \uC138\uB9B0\uC740 \uC218\uC90D\uC74C \uB9CE\uC9C0\uB9CC
    \uC9C4\uC2EC\uC744 \uB2E4\uD558\uB294 \uC218\uC81C\uC790 \uD0DC\uC0DD\uC758 \uD568\uAED8
    \uB9CC\uB4E0 \uACB0\uC2E4\uC5D0 \uD2B9\uBCC4\uD55C \uC758\uBBF8\uB97C \uBD80\uC5EC\uD558\uB294
    \uC131\uACA9\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4."

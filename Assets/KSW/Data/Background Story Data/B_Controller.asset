  characterId: 1
  characterSprite: {fileID: 21300000, guid: 081b60c7a99a3d9408f5b3a91dcc32c5, type: 3}
  characterName: "\uCEE8\uD2B8\uB864\uB7EC"
  gender: "\uC5EC"
  birthday: "4\uC6D4 12\uC77C"
  stature: 164cm
  camp: "\uC2DC\uC800\uC2A4"
  hobby: "\uC5F0\uB9C9\uD0C4 \uC870\uD569, \uBCF4\uB4DC \uAC8C\uC784"
  eatingHabits: "\uC4F4 \uCEE4\uD53C\uB97C \uB07C\uACE0 \uC0B4\uBA70, \uC2DD\uC0AC\uB294
    \uAC04\uB2E8\uD55C \uC0CC\uB4DC\uC704\uCE58\uB85C \uB54C\uC6B0\uB294 \uD3B8"
  individuality: "\uC2DC\uC57C\uB97C \uCC28\uB2E8\uD574 \uC904\uAC8C"
  intro: "\uC804\uC7A5\uC758 \uC2DC\uC57C\uC640 \uAD6C\uC5ED\uC744 \uC9C0\uBC30\uD558\uB294
    \uC804\uC220 \uD1B5\uC81C\uAD00. \uD2B9\uC218 \uC5F0\uB9C9 \uC7A5\uCE58\uC640
    \uAC00\uC2A4 \uC7A5\uBE44\uB97C \uD65C\uC6A9\uD574 \uC801\uC758 \uC2DC\uC57C\uB97C
    \uC644\uC804 \uCC28\uB2E8\uD558\uACE0 \uC544\uAD70\uC758 \uC774\uB3D9 \uACBD\uB85C\uB97C
    \uD655\uBCF4\uD55C\uB2E4. \uC804\uC7A5 \uC804\uCCB4\uC758 \uC9C0\uD615\uC744
    \uD55C\uB208\uC5D0 \uD30C\uC545\uD558\uBA70, \uC0C1\uB300\uC758 \uC2EC\uB9AC\uB97C
    \uC77D\uACE0 \uD310\uC744 \uC124\uACC4\uD558\uB294 \uC9C0\uB7B5\uAC00 \uC2A4\uD0C0\uC77C\uC774\uB2E4."
  observationNotes: "\uC0C1\uD669 \uD310\uB2E8\uC774 \uB9E4\uC6B0 \uBE60\uB974\uACE0
    \uD56D\uC0C1 \uD55C\uB450 \uC218 \uC55E\uC744 \uB0B4\uB2E4\uBCF8\uB2E4. \uC804\uC7A5\uC5D0\uC11C
    \uC801\uC758 \uC2DC\uC57C\uB97C \uAC00\uB9AC\uB294 \uAC83\uBFD0\uB9CC \uC544\uB2C8\uB77C
    \uD300\uC6D0\uB4E4\uC758 \uD1F4\uB85C\uB97C \uBBF8\uB9AC \uD655\uBCF4\uD574 \uB450\uB294
    \uC8FC\uBC00\uD568\uC744 \uBCF4\uC778\uB2E4. \uD3C9\uC18C\uC5D0\uB294 \uC5EC\uC720\uB85C\uC6CC
    \uBCF4\uC774\uC9C0\uB9CC, \uC791\uC804 \uBE0C\uB9AC\uD551 \uC2DC\uC5D0\uB294
    \uC624\uCC28 \uC5C6\uB294 \uC644\uBCBD\uC8FC\uC758\uC801 \uC131\uD5A5\uC744 \uB4DC\uB7EC\uB0B8\uB2E4."
